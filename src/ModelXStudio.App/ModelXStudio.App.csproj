<!--
    作者：zhenhua
    功能：WPF 主工程（net8.0-windows，输出 ModelXStudio.exe）。界面层，引用 Core 类库与
          CommunityToolkit.Mvvm；<Version> 是全项目唯一的版本号来源，界面经 Helpers/AppInfo 读取。
    许可：ModelX Studio 非商业使用许可 1.0（见仓库根 LICENSE）。上游第三方组件（llama.cpp 等）按各自 MIT 许可授权。
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ModelXStudio.App</RootNamespace>
    <AssemblyName>ModelXStudio</AssemblyName>
    <Version>0.1.0</Version>
    <Product>ModelX Studio</Product>
    <Copyright>ModelX</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- Markdown 解析（聊天里渲染模型输出）。钉在 0.22.0：这是本仓库离线环境里已有、
         且代码只用得到它的公开 AST  API 的版本；升大版本时 Markdown/MarkdownX.cs 里的块遍历要跟着看一遍。 -->
    <PackageReference Include="Markdig" Version="0.22.0" />
    <ProjectReference Include="..\ModelXStudio.Core\ModelXStudio.Core.csproj" />
  </ItemGroup>

</Project>
