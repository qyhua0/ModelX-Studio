<!--
    作者：zhenhua
    功能：本地服务页界面：服务开关与状态、运行中的模型、OpenAI 兼容地址与 curl 示例复制、
          引擎运行日志展示（供排查模型加载失败）。
-->
<UserControl x:Class="ModelXStudio.App.Views.ServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:ModelXStudio.App">
    <UserControl.Resources>
        <app:BoolToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="本地推理服务" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusLine}" Margin="0,4,0,12"
                       Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="运行模型：" VerticalAlignment="Center" />
                        <ComboBox Width="280" ItemsSource="{Binding ModelOptions}"
                                  SelectedItem="{Binding SelectedModel}" DisplayMemberPath="DisplayName" />
                        <Button Width="130" Margin="16,0,0,0" Command="{Binding ToggleCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Content" Value="启动服务" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Content" Value="停止服务" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Busy}" Value="True">
                                            <Setter Property="Content" Value="请稍候…" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="OpenAI 兼容地址：" VerticalAlignment="Center" />
                        <TextBox Width="300" Text="{Binding BaseUrl}" IsReadOnly="True" />
                        <Button Content="复制地址" Margin="8,0,0,0" Padding="10,4"
                                Command="{Binding CopyBaseUrlCommand}" />
                        <Button Content="复制调用示例" Margin="8,0,0,0" Padding="10,4"
                                Command="{Binding CopyExampleCommand}" />
                    </StackPanel>

                    <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextDim}"
                               Text="在任意支持 OpenAI API 的软件 / 代码中填写上面的地址即可（无需 API Key）。服务仅监听本机 127.0.0.1，不会暴露到公网。" />
                </StackPanel>
            </Border>

            <TextBlock Text="运行日志" FontWeight="SemiBold" Margin="2,16,0,6" />
            <TextBox x:Name="LogBox" Height="300" IsReadOnly="True"
                     Text="{Binding LogText, Mode=OneWay}"
                     FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" TextChanged="LogBox_TextChanged" />
        </StackPanel>
    </Grid>
</UserControl>
