<!--
    作者：zhenhua
    功能：聊天页界面。左侧会话列表（新建 / 搜索 / 右键重命名·置顶·导出·删除，F2 改名、Delete 删除）；
          顶部模型与生成风格选择、引擎状态、手工加载与卸载；中间消息气泡（回复侧走 Markdown 渲染 +
          代码高亮，用户侧保持纯文本）；气泡下方一行小字（时间 / 耗时 / token / tok每秒）与「复制」；
          输入框上方是上下文占用条（本轮要发多少 / 窗口多大 / 超了怎么办）；底部输入框
          （Enter 发送，Shift+Enter 换行）与发送 / 停止 / 重新生成；顶部「参数」展开后是微调参数面板。
    许可：ModelX Studio 非商业使用许可 1.0（见仓库根 LICENSE）。上游第三方组件（llama.cpp 等）按各自 MIT 许可授权。
-->
<UserControl x:Class="ModelXStudio.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:ModelXStudio.App"
             xmlns:ctl="clr-namespace:ModelXStudio.App.Controls">
    <UserControl.InputBindings>
        <!-- 会话一多，「新建」就成了最高频动作；Ctrl+N 是浏览器/资源管理器给的肌肉记忆 -->
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewChatCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <app:BoolToVisibilityConverter x:Key="BoolVis" />
        <app:FalseToVisibilityConverter x:Key="FalseVis" />
        <app:StringToVisibilityConverter x:Key="StrVis" />
        <app:InverseBoolConverter x:Key="NotBool" />

        <!-- 消息列表项：无边框无选中高亮 -->
        <Style x:Key="MsgItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 会话列表项：整行可点，选中/悬停给底色（原来用的是系统默认样式，选中是一块刺眼的蓝） -->
        <Style x:Key="ConvItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Margin="6,2" Padding="9,7" CornerRadius="8"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSelected}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 上下文占用条：默认 ProgressBar 是浅色控件，深色主题下一眼就看出不是同一套 -->
        <Style x:Key="CtxBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{StaticResource BrushPanelAlt}" CornerRadius="2.5" ClipToBounds="True">
                            <!-- PART_Track / PART_Indicator 是 ProgressBar 认的名字，进度靠它算宽度 -->
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 八分以上转黄，超了转红：颜色本身就是提醒，不用再多弹一个框 -->
                <DataTrigger Binding="{Binding ContextWarn}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ContextOver}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 会话列表 ==================== -->
        <Border Grid.Column="0" Background="{StaticResource BrushPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,12,12,6">
                    <Button Content="＋ 新建" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewChatCommand}" Padding="10,6" HorizontalAlignment="Left"
                            ToolTip="开一个新对话（Ctrl+N）" />
                    <TextBlock Text="{Binding ChatCountText}" FontSize="11" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Foreground="{StaticResource BrushTextDim}" />
                </Grid>

                <!-- 搜索：标题和任意一条正文命中都算。Delay=200 是免得每敲一个字就全文扫一遍 -->
                <Grid DockPanel.Dock="Top" Margin="12,0,10,8">
                    <TextBox x:Name="SearchBox" FontSize="12" Padding="7,5"
                             Text="{Binding ChatSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ToolTip="按标题或正文搜会话；Esc 清空"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock Text="🔍 搜索会话" FontSize="12" Margin="9,0,0,0" IsHitTestVisible="False"
                               VerticalAlignment="Center" Foreground="{StaticResource BrushTextFaint}"
                               Visibility="{Binding ShowSearchHint, Converter={StaticResource BoolVis}}" />
                </Grid>

                <TextBlock DockPanel.Dock="Bottom" Margin="12,6,12,10" FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{StaticResource BrushTextFaint}"
                           Text="右键会话可改名 / 置顶 / 导出 Markdown；F2 改名，Delete 删除。" />

                <Grid>
                    <ListBox x:Name="ChatList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ConvItem}"
                             ItemsSource="{Binding ShownConversations}"
                             SelectedItem="{Binding SelectedConversation}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="ChatList_MouseDoubleClick"
                             PreviewKeyDown="ChatList_PreviewKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Tag 里放 ViewModel：右键菜单弹在可视树外面，命令只能这样递进去 -->
                                <Border Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="重命名"
                                                      Command="{Binding PlacementTarget.Tag.RenameChatCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                            <MenuItem Header="置顶 / 取消置顶"
                                                      Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                            <MenuItem Header="导出为 Markdown"
                                                      Command="{Binding PlacementTarget.Tag.ExportChatCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                            <Separator />
                                            <MenuItem Header="删除"
                                                      Command="{Binding PlacementTarget.Tag.DeleteChatCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <!-- 用 DockPanel 不用横向 StackPanel：后者会给标题无限宽，
                                             TextTrimming 永远不生效（长会话名把列表撑出一条横向滞动条），
                                             而想靠 MaxWidth 救就得写死一个数字。 -->
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="📌" FontSize="10" Margin="0,0,5,0"
                                                       ToolTip="已置顶"
                                                       Visibility="{Binding Pinned, Converter={StaticResource BoolVis}}" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource BrushText}" />
                                        </DockPanel>
                                        <TextBlock FontSize="10.5" Foreground="{StaticResource BrushTextDim}"
                                                   Text="{Binding ListHint}" TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                        <TextBlock FontSize="10" Foreground="{StaticResource BrushTextFaint}"
                                                   Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding NoChatsHint}" FontSize="11.5" TextWrapping="Wrap"
                               Margin="16,10" VerticalAlignment="Top"
                               Foreground="{StaticResource BrushTextFaint}"
                               Visibility="{Binding HasNoChats, Converter={StaticResource BoolVis}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ==================== 聊天区 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部：状态 + 模型选择 + 风格 + 参数开关 + 手工加载/卸载 -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding EngineStatusLine}" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextDim}" TextTrimming="CharacterEllipsis" />
                    <ComboBox Grid.Column="1" Width="220" VerticalAlignment="Center"
                              ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModel}"
                              DisplayMemberPath="DisplayName" ToolTip="切换模型（需已下载）。选中即加载；想先不加载，去「设置」关掉自动加载"
                              Tag="还没有已下载的模型，先到「模型库」下载" />
                    <ComboBox Grid.Column="2" Width="96" Margin="8,0,0,0" VerticalAlignment="Center"
                              ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding SelectedPreset}"
                              ToolTip="回复风格：快速 / 均衡 / 高质量。&#10;手动改任何一个参数会自动落到「自定义」。" />
                    <!-- 摘要写在按钮上：面板收起时也能一眼看见现在跑的是什么值 -->
                    <Button Grid.Column="3" Margin="8,0,0,0" Padding="9,4" VerticalAlignment="Center"
                            Content="{Binding ParamsSummary}" Command="{Binding ToggleParamsCommand}"
                            ToolTip="展开/收起微调参数" />
                    <!-- 手工加载 / 卸载：大模型挂着几个 G，用完得能主动放掉 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Margin="8,0,0,0" Padding="9,4" Content="重新加载"
                                Command="{Binding ReloadModelCommand}"
                                IsEnabled="{Binding IsModelBusy, Converter={StaticResource NotBool}}"
                                Visibility="{Binding EngineReady, Converter={StaticResource FalseVis}}"
                                ToolTip="把模型读回内存。改了「上下文长度」必须重载才生效。" />
                        <Button Margin="8,0,0,0" Padding="9,4" Content="卸载"
                                Command="{Binding UnloadModelCommand}"
                                IsEnabled="{Binding IsModelBusy, Converter={StaticResource NotBool}}"
                                Visibility="{Binding EngineReady, Converter={StaticResource BoolVis}}"
                                ToolTip="把模型从内存里放掉（正在生成时要先停止）" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 微调参数面板：默认收起（产品原则是不让普通用户一进来就看见十个旋钮），限宽与消息列同宽 -->
            <Border Grid.Row="1" Background="{StaticResource BrushPanelAlt}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                    Visibility="{Binding ShowParams, Converter={StaticResource BoolVis}}">
                <StackPanel Margin="16,10" MaxWidth="{StaticResource WidthChat}" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="微调参数 · 改一项下一条就生效，自动保存" Foreground="{StaticResource BrushTextDim}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding ParamsSavedHint}" Foreground="{StaticResource BrushSuccess}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="恢复默认" Padding="9,4" Command="{Binding ResetParamsCommand}"
                                    ToolTip="回到出厂值，连系统提示词和模型标识一起清空" />
                        </StackPanel>
                    </Grid>

                    <!-- 左列：采样类；右列：长度与种子。滑块和输入框绑同一个值的不同面：
                         滑块绑 double（拖着顺手），输入框绑 *Text（能精确打字，也容得下「不限」这种写法） -->
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Grid Margin="0,3,12,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="温度" Style="{StaticResource ParamLabel}"
                                       ToolTip="越低越稳健重复，越高越发散有创意；0 = 几乎确定回答。常见 0.3–1.0" />
                            <Slider Grid.Column="1" Style="{StaticResource ParamSlider}" VerticalAlignment="Center"
                                    Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.2" TickFrequency="0.05"
                                    Value="{Binding Temperature, Mode=TwoWay}" />
                            <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding TemperatureText}"
                                     ToolTip="可以直接打字，超出 0–2 会自动夹到边界" />
                        </Grid>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="top_p" Style="{StaticResource ParamLabel}"
                                       ToolTip="核采样：只在概率累计到这个比例的词里挑。与 top-k 二选一即可" />
                            <Slider Grid.Column="1" Style="{StaticResource ParamSlider}" VerticalAlignment="Center"
                                    Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01"
                                    Value="{Binding TopP, Mode=TwoWay}" />
                            <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding TopPText}" />
                        </Grid>

                        <Grid Margin="0,3,12,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="top_k" Style="{StaticResource ParamLabel}"
                                       ToolTip="只在概率最高的 k 个词里挑；0 = 不限制个数" />
                            <Slider Grid.Column="1" Style="{StaticResource ParamSlider}" VerticalAlignment="Center"
                                    Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" TickFrequency="1"
                                    Value="{Binding TopK, Mode=TwoWay}" IsSnapToTickEnabled="True" />
                            <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding TopKText}" />
                        </Grid>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="min_p" Style="{StaticResource ParamLabel}"
                                       ToolTip="概率太低的话直接抖掉（比 top_p 更能防胡话）；0 = 关掉" />
                            <Slider Grid.Column="1" Style="{StaticResource ParamSlider}" VerticalAlignment="Center"
                                    Minimum="0" Maximum="0.5" SmallChange="0.005" LargeChange="0.05" TickFrequency="0.005"
                                    Value="{Binding MinP, Mode=TwoWay}" />
                            <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding MinPText}" />
                        </Grid>

                        <Grid Margin="0,3,12,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="重复惩罚" Style="{StaticResource ParamLabel}"
                                       ToolTip="说过的词下次再说的代价；1 = 不惩罚，超过 1.3 容易连词不成词" />
                            <Slider Grid.Column="1" Style="{StaticResource ParamSlider}" VerticalAlignment="Center"
                                    Minimum="1" Maximum="2" SmallChange="0.01" LargeChange="0.1" TickFrequency="0.01"
                                    Value="{Binding RepeatPenalty, Mode=TwoWay}" />
                            <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding RepeatPenaltyText}" />
                        </Grid>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="随机种子" Style="{StaticResource ParamLabel}"
                                       ToolTip="固定种子 + 固定提示词 = 可复现的回答；0 = 每次随机" />
                            <TextBox Grid.Column="1" Text="{Binding SeedText}"
                                     ToolTip="输「随机」或 0 = 每次不一样" />
                            <Button Grid.Column="2" Margin="8,0,0,0" Content="换一个" Padding="8,4"
                                    Command="{Binding RollSeedCommand}" ToolTip="随机换一个种子" />
                        </Grid>

                        <Grid Margin="0,3,12,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最大长度" Style="{StaticResource ParamLabel}"
                                       ToolTip="单次回复的 token 上限；输「不限」或 -1 = 一直写到上下文用完" />
                            <TextBox Grid.Column="1" Text="{Binding MaxTokensText}" />
                        </Grid>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模型标识" Style="{StaticResource ParamLabel}"
                                       ToolTip="请求体里的 model 字段：本程序自带的 llama-server 用不上；&#10;把地址指向别的 OpenAI 兼容服务时填那边的模型名" />
                            <TextBox Grid.Column="1" Text="{Binding ModelId}" ToolTip="{Binding ModelIdHint}" />
                        </Grid>
                    </UniformGrid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="系统提示词" Style="{StaticResource ParamLabel}" VerticalAlignment="Top" Margin="0,5,0,0"
                                   ToolTip="每轮对话开头悄悄带上的人设；改完下一条消息就生效" />
                        <TextBox Grid.Column="1" Height="46" Text="{Binding SystemPrompt}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </Grid>
                    <TextBlock Style="{StaticResource ParamHint}" Margin="86,4,0,0" Text="{Binding SystemPromptHint}" />
                </StackPanel>
            </Border>

            <!-- 提示条：上次没写完的回复 / 这轮截断过 / 模型已卸载。都写在消息列表外面，
                 免得滚到下面就被顶没了 -->
            <StackPanel Grid.Row="2" MaxWidth="{StaticResource WidthChat}" HorizontalAlignment="Stretch" Margin="16,8,16,0">
                <Border Background="{StaticResource BrushPanelAlt}" BorderBrush="{StaticResource BrushWarning}"
                        BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,6"
                        Visibility="{Binding HasRestoreNotice, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding RestoreNotice}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource BrushText}" />
                </Border>
                <Border Background="{StaticResource BrushPanelAlt}" BorderBrush="{StaticResource BrushAccent}"
                        BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,6"
                        Visibility="{Binding HasTrimNotice, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding TrimNotice}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource BrushText}" />
                </Border>
                <Border Background="{StaticResource BrushPanelAlt}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,6"
                        Visibility="{Binding AwaitLoadHint, Converter={StaticResource StrVis}}">
                    <TextBlock Text="{Binding AwaitLoadHint}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource BrushTextDim}" />
                </Border>
            </StackPanel>

            <!-- 消息 -->
            <!-- 对话列限宽居中（WidthChat）：不留原来 1000 那么窄，也不让一行文字横穿整块屏 -->
            <ListBox Grid.Row="3" x:Name="MessageList"
                     ItemsSource="{Binding Messages}"
                     ItemContainerStyle="{StaticResource MsgItem}"
                     Background="Transparent"
                     MaxWidth="{StaticResource WidthChat}" HorizontalAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Padding="16,10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border MaxWidth="{StaticResource WidthChatBubble}" Padding="12,9" CornerRadius="10" Margin="0,5"
                                Background="{StaticResource BrushBotBubble}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Background" Value="{StaticResource BrushUserBubble}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding RoleLabel}" FontSize="10"
                                           Foreground="{StaticResource BrushTextDim}" Margin="0,0,0,4" />

                                <!-- 用户自己打的字保持纯文本；回复走 Markdown（含代码高亮、复制按钮、链接） -->
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                           Foreground="{StaticResource BrushText}"
                                           Visibility="{Binding IsUser, Converter={StaticResource BoolVis}}" />
                                <ctl:MarkdownView Markdown="{Binding MarkdownText}"
                                                  Streaming="{Binding Busy}"
                                                  RenderMarkdown="{Binding DataContext.RenderMarkdown, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                  FontSize="13.5" Foreground="{StaticResource BrushText}"
                                                  Visibility="{Binding IsUser, Converter={StaticResource FalseVis}}" />

                                <TextBlock Text="{Binding NoticeText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{StaticResource BrushWarning}"
                                           Visibility="{Binding HasNotice, Converter={StaticResource BoolVis}}" />

                                <!-- 生成中的实时状态：光有进度条不够，得知道它到底在不在动 -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                            Visibility="{Binding HasLive, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="▍" Foreground="{StaticResource BrushAccent}" FontSize="12" />
                                    <TextBlock Text="{Binding LiveText}" FontSize="11" Margin="4,0,0,0"
                                               Foreground="{StaticResource BrushTextDim}" />
                                </StackPanel>

                                <!-- 落款：时间 · 耗时 · token · 速度，外加「复制」。复制绑 VM 上的命令 -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Meta}" FontSize="10.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTextFaint}"
                                               Visibility="{Binding HasMeta, Converter={StaticResource BoolVis}}" />
                                    <!-- 只给复制：重答永远是「最后一条」的事，挂在每条气泡上反而像能单独重答中间那条 -->
                                    <Button Content="复制" Margin="10,0,0,0" Style="{StaticResource LinkButton}"
                                            Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding HasContent, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 输入区 -->
            <Border Grid.Row="4" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
                <!-- 同样 Stretch + MaxWidth：这个 Grid 里有 * 列，Center 会让输入框按内容缩成一小条 -->
                <DockPanel Margin="16,10" MaxWidth="{StaticResource WidthChat}" HorizontalAlignment="Stretch">

                    <!-- 上下文占用条：本轮要发多少 / 窗口多大 / 快满了怎么办。鼠标停上去看完整账目 -->
                    <Grid DockPanel.Dock="Top" Margin="2,0,2,8" ToolTip="{Binding ContextDetail}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Style="{StaticResource CtxBar}" VerticalAlignment="Center" Margin="0,0,10,0"
                                     Value="{Binding ContextPercent, Mode=OneWay}" Minimum="0" Maximum="100" />
                        <TextBlock Grid.Column="1" Text="{Binding ContextShort}" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{StaticResource BrushTextDim}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputBox" Grid.Column="0"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="100" MaxHeight="320" Padding="10,9"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="InputBox_PreviewKeyDown" />
                        <Button Grid.Column="1" Content="发送" Width="80" Margin="10,0,0,0"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                                Command="{Binding SendCommand}" />
                        <Button Grid.Column="2" Content="停止" Width="66" Margin="8,0,0,0"
                                VerticalAlignment="Bottom"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                                Command="{Binding StopGenerationCommand}" />
                        <Button Grid.Column="3" Content="重新生成" Width="80" Margin="8,0,0,0"
                                VerticalAlignment="Bottom"
                                Visibility="{Binding IsBusy, Converter={StaticResource FalseVis}}"
                                Command="{Binding RegenerateCommand}"
                                ToolTip="把最后一条回复丢掉，照原问题重答一次（答得不好 / 上次没写完都用它）" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
