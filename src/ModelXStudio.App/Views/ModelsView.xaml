<!--
    作者：zhenhua
    功能：模型库页界面：llama.cpp 引擎缺失、以及只有 CPU 版时的指引提示条（打开目录 / 复制官方
          下载地址 / 重新检查，程序本身不联网下载引擎）、本机硬件体检结论、
          精选模型卡片（介绍 / 量化档下拉 / 下载进度 / 适配建议）、本地已下载模型列表与直链导入。
    许可：ModelX Studio 非商业使用许可 1.0（见仓库根 LICENSE）。上游第三方组件（llama.cpp 等）按各自 MIT 许可授权。
-->
<UserControl x:Class="ModelXStudio.App.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:ModelXStudio.App">
    <UserControl.Resources>
        <app:BoolToVisibilityConverter x:Key="BoolVis" />
        <app:FalseToVisibilityConverter x:Key="FalseVis" />
        <app:InverseBoolConverter x:Key="InvBool" />
        <app:ModelFitToLedConverter x:Key="FitLed" />
        <app:StringToVisibilityConverter x:Key="HasText" />
        <app:CardStateLevelToBrushConverter x:Key="StateBrush" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <!-- 铺满窗口，只在超宽带鱼屏上封顶（上限见 Themes/Dark.xaml 的 WidthPageWide）。
             注意别写 HorizontalAlignment="Center"：Center 是按「内容期望宽度」收缩再居中，
             子项里有 * 列时会整页缩成一条；Stretch + MaxWidth 才是「宽度取槽位与上限的较小者，
             被上限卡住时 WPF 自己居中」。 -->
        <StackPanel MaxWidth="{StaticResource WidthPageWide}">

            <!-- 引擎缺失指引：llama.cpp 随安装包分发，缺文件时按这里指的路径放好即可 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                    BorderBrush="{StaticResource BrushWarning}"
                    Visibility="{Binding ShowEngineMissing, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="缺少推理引擎（llama.cpp）" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding EngineStatusText}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{StaticResource BrushTextDim}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="打开引擎文件夹" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenEngineFolderCommand}" />
                        <Button Content="复制下载地址" Margin="10,0,0,0"
                                Command="{Binding CopyEngineLinkCommand}" />
                        <Button Content="我已放好，重新检查" Margin="10,0,0,0"
                                Command="{Binding RescanEngineCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 引擎忙碌提示（横幅隐藏时） -->
            <TextBlock Text="{Binding EngineStatusText}" Margin="2,0,0,10"
                       Foreground="{StaticResource BrushAccent}"
                       Visibility="{Binding EngineBusy, Converter={StaticResource BoolVis}}" />

            <!-- 只带了 CPU 版、但本机有 N 卡：提示可以补上 GPU 版 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                    BorderBrush="{StaticResource BrushAccent}"
                    Visibility="{Binding ShowGpuUpgrade, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="检测到 NVIDIA 显卡，可以用 GPU 加速" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="当前只有 CPU 版。把 llama.cpp 的 CUDA 包（文件名形如 llama-b…-bin-win-cuda-12.x-x64.zip，优先选 CUDA 12）解压到 runtime\llama\cuda；驱动太旧装不了 CUDA 时，放 Vulkan 包（llama-b…-bin-win-vulkan-x64.zip）到 runtime\llama\vulkan 也行。放好点「重新检查」并重新加载模型，模型会加载进显存运行，生成速度通常提升数倍。"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{StaticResource BrushTextDim}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="打开 GPU 目录" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenEngineFolderCommand}" />
                        <Button Content="复制下载地址" Margin="10,0,0,0"
                                Command="{Binding CopyEngineLinkCommand}" />
                        <Button Content="我已放好，重新检查" Margin="10,0,0,0"
                                Command="{Binding RescanEngineCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 本机硬件体检 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                    Visibility="{Binding HasHardware, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="本机硬件体检" FontWeight="SemiBold" FontSize="14" />
                        <Button Content="重新检测" Margin="12,0,0,0" Padding="8,3" FontSize="11"
                                Command="{Binding RefreshListCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding HardwareLine1}" Margin="0,8,0,0"
                               Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding HardwareLine2}" Margin="0,3,0,0"
                               Foreground="{StaticResource BrushTextDim}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding HardwareAdvice}" Margin="0,8,0,0"
                               Foreground="{StaticResource BrushAccent}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 本地模型 -->
            <StackPanel Orientation="Horizontal" Margin="2,4,0,4">
                <TextBlock Text="本地模型" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Content="刷新" Margin="14,0,0,0" Padding="10,4" Command="{Binding RefreshListCommand}" />
                <TextBox Width="280" Margin="16,0,0,0" Text="{Binding ImportUrl}"
                         IsEnabled="{Binding IsImporting, Converter={StaticResource InvBool}}"
                         ToolTip="粘贴任意 .gguf 模型直链导入" />
                <!-- 导入以前不能取消，进度还写到「缺引擎」那一行里，导完了那里挂着「导入中 100%」
                     像没下完；现在进度自己一行，按钮导入中变「取消导入」。 -->
                <Button Content="导入链接" Margin="8,0,0,0" Padding="10,4"
                        Visibility="{Binding IsImporting, Converter={StaticResource FalseVis}}"
                        Command="{Binding ImportFromUrlCommand}" />
                <Button Content="取消导入" Margin="8,0,0,0" Padding="10,4"
                        Visibility="{Binding IsImporting, Converter={StaticResource BoolVis}}"
                        Command="{Binding CancelImportCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding ImportStatusText}" Margin="2,4,0,0" FontSize="12" TextWrapping="Wrap"
                       Visibility="{Binding ImportStatusText, Converter={StaticResource HasText}}"
                       Foreground="{StaticResource BrushTextDim}" />
            <TextBlock Margin="2,6" Foreground="{StaticResource BrushTextDim}"
                       Text="还没有下载模型，从下面的精选模型开始吧 ↓">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Locals.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Locals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Model.DisplayName}" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Model.SizeText}" FontSize="11"
                                                   Foreground="{StaticResource BrushTextDim}" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource BrushTextDim}"
                                                   Text="{Binding Model.ModifiedAt, StringFormat={}{0:  yyyy-MM-dd HH:mm}}" />
                                    </StackPanel>
                                    <!-- 适配等级：小绿灯（等级 Unknown 时整颗不显示，见 Dark.xaml 的 StatusLed） -->
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Style="{StaticResource StatusLed}" Width="11" Height="11"
                                              VerticalAlignment="Top" Margin="1,2,0,0">
                                            <Ellipse Fill="{Binding FitLevel, Converter={StaticResource FitLed}, ConverterParameter=halo}" />
                                            <Ellipse Width="7" Height="7"
                                                     Fill="{Binding FitLevel, Converter={StaticResource FitLed}}" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding FitText}" FontSize="11"
                                                   Margin="6,0,0,0" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextDim}" />
                                    </Grid>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource BrushSuccess}"
                                        CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Margin="0,0,10,0"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="运行中" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <Button Grid.Column="2" Content="加载" Padding="12,4" VerticalAlignment="Center"
                                        Style="{StaticResource PrimaryButton}"
                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}"
                                        Command="{Binding LoadCommand}" />
                                <Button Grid.Column="3" Content="打开位置" Padding="10,4" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding ShowInFolderCommand}" />
                                <Button Grid.Column="4" Content="删除" Padding="10,4" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding DeleteCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 精选模型 -->
            <TextBlock Text="精选模型（一键下载）" FontSize="16" FontWeight="Bold" Margin="2,18,0,8" />

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding Entry.Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Entry.Tagline}" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource BrushAccent}" />
                                    <TextBlock Text="{Binding TagsText}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{StaticResource BrushTextDim}" />
                                    <!-- 适配等级指示灯：绿＝能整份装进显存（就是原本想用 🟢 的那个点，
                                         emoji 在 WPF 里只会画成灰白空心圈，所以改成真的矢量小灯） -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Style="{StaticResource StatusLed}" VerticalAlignment="Top"
                                              Margin="1,3,0,0">
                                            <Ellipse Fill="{Binding FitLevel, Converter={StaticResource FitLed}, ConverterParameter=halo}" />
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{Binding FitLevel, Converter={StaticResource FitLed}}" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding FitText}" FontSize="12"
                                                   Margin="7,0,0,0" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>

                                <!-- 右侧整块锁定宽度：下载中百分比与速度每秒变好几次，宽度跟着内容走的话
                                     整个卡片右侧会左右跳，数字也看不清。两个数字各占固定宽度并右对齐，
                                     位数变化只动自己那一格的左边缘。 -->
                                <StackPanel Grid.Column="1" Width="252" VerticalAlignment="Center">
                                    <Grid Height="20" Margin="0,0,0,4">
                                        <!-- 未下载 / 已下载 / 已取消 / 失败：整句右对齐，太长就换行 -->
                                        <TextBlock Text="{Binding StateText}" FontSize="12"
                                                   TextWrapping="Wrap" TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsDownloading, Converter={StaticResource FalseVis}}"
                                                   Foreground="{Binding StateLevel, Converter={StaticResource StateBrush}}" />
                                        <!-- 下载中：等宽数字，不跟着位数跑 -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding PercentText}" Width="46"
                                                       FontFamily="Consolas, Microsoft YaHei UI"
                                                       TextAlignment="Right" />
                                            <TextBlock Text="·" Margin="5,0"
                                                       Foreground="{StaticResource BrushTextFaint}" />
                                            <TextBlock Text="{Binding SpeedText}" Width="82"
                                                       FontFamily="Consolas, Microsoft YaHei UI"
                                                       TextAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- 按钮跟着磁盘上的事实走，不跟「点过一下」走：文件已在本地就只剩
                                         「打开目录 / 重新下载」，不会再出现「下完了还写下载」；
                                         有残片则变「继续下载」并多一个「清除残片」。宽度固定，切字不跳位。 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{Binding ActionText}" Style="{StaticResource PrimaryButton}" Width="86"
                                                Visibility="{Binding HasPrimaryAction, Converter={StaticResource BoolVis}}"
                                                Command="{Binding DownloadCommand}" />
                                        <Button Content="清除残片" Width="74" Margin="0,0,8,0" Padding="10,4"
                                                ToolTip="删掉未完成的 .part 文件，下次要从头下载"
                                                Visibility="{Binding IsResumable, Converter={StaticResource BoolVis}}"
                                                Command="{Binding ClearPartialCommand}" />
                                        <Button Content="取消" Width="86"
                                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}"
                                                Command="{Binding CancelDownloadCommand}" />
                                        <Button Content="打开目录" Width="74" Margin="0,0,8,0" Padding="10,4"
                                                ToolTip="在资源管理器里选中这个模型文件"
                                                Visibility="{Binding IsDownloaded, Converter={StaticResource BoolVis}}"
                                                Command="{Binding ShowFileCommand}" />
                                        <Button Content="重新下载" Width="74" Padding="10,4"
                                                Visibility="{Binding IsDownloaded, Converter={StaticResource BoolVis}}"
                                                Command="{Binding DownloadCommand}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Entry.Description}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                                           Foreground="{StaticResource BrushTextDim}" />

                                <ComboBox Grid.Row="2" Grid.ColumnSpan="2" Width="460" HorizontalAlignment="Left"
                                          Margin="0,10,0,0" ItemsSource="{Binding Options}"
                                          DisplayMemberPath="DisplayText"
                                          Tag="这个模型暂时没有可选的下载文件"
                                          IsEnabled="{Binding IsDownloading, Converter={StaticResource InvBool}}"
                                          SelectedItem="{Binding SelectedOption}" />

                                <ProgressBar Grid.Row="3" Grid.ColumnSpan="2" Height="6" Margin="0,10,0,0"
                                             Maximum="100" Value="{Binding Percent}"
                                             Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
