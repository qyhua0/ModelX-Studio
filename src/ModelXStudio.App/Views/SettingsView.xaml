<!--
    作者：zhenhua
    功能：设置页界面：模型存放目录、本地服务端口、HuggingFace 镜像站点、上下文长度与「装不下时怎么办」、
          默认生成风格、引擎偏好（自动 / CUDA / Vulkan / 仅 CPU）、随包 llama.cpp 引擎状态与目录（可改指向已有引擎）、
          启动自动加载上次模型、启动回到上次会话、Markdown 渲染开关、保存结果提示，
          以及底部的 llama.cpp 致谢与非商业许可说明。
    许可：ModelX Studio 非商业使用许可 1.0（见仓库根 LICENSE）。上游第三方组件（llama.cpp 等）按各自 MIT 许可授权。
-->
<UserControl x:Class="ModelXStudio.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:ModelXStudio.App">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <!-- 表单上限 WidthPageForm；用 Stretch 不用 Center：Center 会让带 * 列的行按内容收缩，
             整页缩成中间一条，两边空得更多（就是之前「左右一大片空白」的真凶）。 -->
        <StackPanel MaxWidth="{StaticResource WidthPageForm}">
            <TextBlock Text="设置" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 模型目录 -->
                    <TextBlock Grid.Row="0" Text="模型存放目录" VerticalAlignment="Center" Margin="0,8" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,8"
                             Text="{Binding ModelsDirectory}" />
                    <Button Grid.Row="0" Grid.Column="2" Content="浏览…" Margin="8,8,0,8" Padding="10,4"
                            Command="{Binding BrowseModelsCommand}" />

                    <!-- 端口 -->
                    <TextBlock Grid.Row="1" Text="本地服务端口" VerticalAlignment="Center" Margin="0,8" />
                    <TextBox Grid.Row="1" Grid.Column="1" Width="110" HorizontalAlignment="Left" Margin="0,8"
                             Text="{Binding ServerPort}" />

                    <!-- 上下文 -->
                    <TextBlock Grid.Row="2" Text="上下文长度" VerticalAlignment="Center" Margin="0,8" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Width="130" HorizontalAlignment="Left" Margin="0,8"
                              ItemsSource="{Binding ContextOptions}" SelectedItem="{Binding ContextSizeOption}"
                              ToolTip="越大越能记住长对话，也更吃内存。普通用户 4096 即可。" />

                    <!-- 风格 -->
                    <TextBlock Grid.Row="3" Text="默认回复风格" VerticalAlignment="Center" Margin="0,8" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="0,8"
                              ItemsSource="{Binding PresetLabels}" SelectedItem="{Binding DefaultPreset}"
                              ToolTip="只决温度 / top-p / top-k 三个常用值。&#10;min-p、重复惩罚、系统提示词、随机种子这些单项微调在「AI 对话」页上方的「参数」面板里。" />

                    <!-- 镜像 -->
                    <TextBlock Grid.Row="4" Text="模型下载镜像" VerticalAlignment="Center" Margin="0,8" />
                    <ComboBox Grid.Row="4" Grid.Column="1" IsEditable="True" Margin="0,8"
                              ItemsSource="{Binding MirrorOptions}" Text="{Binding HfMirror}"
                              ToolTip="国内网络建议使用 hf-mirror.com" />

                    <!-- 自动加载 -->
                    <TextBlock Grid.Row="5" Text="启动时" VerticalAlignment="Center" Margin="0,8" />
                    <CheckBox Grid.Row="5" Grid.Column="1" Content="自动加载上次使用的模型"
                              VerticalAlignment="Center" Margin="0,8"
                              IsChecked="{Binding AutoLoadLastModel}" />

                    <!-- 引擎偏好 -->
                    <TextBlock Grid.Row="6" Text="推理引擎" VerticalAlignment="Center" Margin="0,8" />
                    <ComboBox Grid.Row="6" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,8"
                              ItemsSource="{Binding EnginePrefLabels}" SelectedItem="{Binding EnginePreference}"
                              ToolTip="自动：有 NVIDIA 显卡用 CUDA，没有 N 卡但有其它显卡（含 Intel 核显）就用 Vulkan，都没有就用 CPU。只影响选哪个已随包的引擎，本程序不会联网下载。" />

                    <!-- 当前引擎状态：变体 + 构建号 + 所在目录 -->
                    <TextBlock Grid.Row="7" Text="当前引擎" VerticalAlignment="Center" Margin="0,8" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding EngineSummary}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Row="7" Grid.Column="2" Content="打开目录" Margin="8,8,0,8" Padding="10,4"
                            Command="{Binding OpenEngineFolderCommand}"
                            ToolTip="打开应当存放 llama.cpp 的目录。约定：cpu\ 放 CPU 包、vulkan\ 放 Vulkan 包、cuda\ 放 CUDA 包（每个子目录里要有 llama-server.exe 与同批 dll）" />

                    <!-- 引擎目录：默认随程序分发，也可以指向自己已有的 llama.cpp -->
                    <TextBlock Grid.Row="8" Text="引擎目录" VerticalAlignment="Center" Margin="0,8" />
                    <TextBox Grid.Row="8" Grid.Column="1" Margin="0,8" Text="{Binding EngineRoot}"
                             TextWrapping="NoWrap"
                             ToolTip="留空表示用程序自带的 runtime\llama。如果你本机已经有 llama.cpp（里面有 llama-server.exe），可以把它的目录填在这里（优先级最高）。"
                             />   
                    <StackPanel Grid.Row="8" Grid.Column="2" Orientation="Horizontal" Margin="8,8,0,8">
                        <Button Content="浏览…" Padding="10,4"
                                Command="{Binding BrowseEngineRootCommand}" />
                        <Button Content="用自带" Margin="8,0,0,0" Padding="10,4"
                                Command="{Binding ClearEngineRootCommand}"
                                ToolTip="清掉自定义路径，回到随程序分发的 runtime\llama" />
                    </StackPanel>

                    <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{StaticResource BrushTextFaint}"
                               Text="本程序不再联网下载推理引擎：llama.cpp 随安装包一起提供。缺文件时到「模型库」页按提示补上。" />
                </Grid>
            </Border>

            <!-- 对话与显示：上下文装不下怎么办、预留多少、要不要渲染 Markdown、重启后回到哪 -->
            <TextBlock Text="对话与显示" FontSize="13" FontWeight="SemiBold" Margin="2,16,0,8" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="上下文不够时" VerticalAlignment="Center" Margin="0,8" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="230" HorizontalAlignment="Left" Margin="0,8"
                              ItemsSource="{Binding ContextStrategyOptions}" SelectedItem="{Binding ContextStrategyOption}"
                              ToolTip="聊天窗口（上下文）就那么大。装不下时：&#10;· 自动省略最旧的几轮：悄悄丢掉最早的消息，接着聊，不打断你；&#10;· 先问我：内容原样发，弹出提示由你决定是继续还是开新会话。&#10;（进度条和「约用了多少上下文」显示在「AI 对话」页输入框上方。）" />

                    <TextBlock Grid.Row="1" Text="给回复预留" VerticalAlignment="Center" Margin="0,8" />
                    <TextBox Grid.Row="1" Grid.Column="1" Width="110" HorizontalAlignment="Left" Margin="0,8"
                             Text="{Binding ContextReserveTokens}"
                             ToolTip="留空 = 自动（按「最大长度」与上下文的 1/4 取小的）。&#10;想让模型一次写长文又不出窗口，可以手动填个大点的数。单位是 token。" />

                    <TextBlock Grid.Row="2" Text="回复显示" VerticalAlignment="Center" Margin="0,8" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8">
                        <CheckBox Content="用 Markdown 排版回复（标题 / 列表 / 表格 / 代码高亮 + 一键复制）"
                                  IsChecked="{Binding RenderMarkdown}" />
                        <TextBlock Text="勾掉就按纯文本显示，想知道「这段到底是模型写的还是排版弄的」时用它对照。"
                                   FontSize="11" Margin="22,4,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextFaint}" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="对话记录" VerticalAlignment="Center" Margin="0,8" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,8">
                        <CheckBox Content="启动后回到上次正在看的会话" IsChecked="{Binding RestoreLastChat}" />
                        <TextBlock Text="程序被关掉、被系统杀掉、显存不够崩了都管用：重开还是那一轮，最后一条没写完的回复会标出来并补一个「重新生成」。"
                                   FontSize="11" Margin="22,4,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextFaint}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
                <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Width="110"
                        Command="{Binding SaveCommand}" />
                <TextBlock Text="{Binding SavedHint}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource BrushSuccess}" />
            </StackPanel>

            <TextBlock Margin="2,16,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextDim}"
                       Text="提示：修改端口或上下文长度后，需要重新加载模型才会生效。所有模型文件与对话记录都保存在本机，不会上传。" />

            <!-- 底部：致谢与许可（与仓库 LICENSE / THIRD_PARTY_NOTICES.md 保持一致） -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="致谢与许可" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0" FontSize="12" LineHeight="20" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextDim}"
                               Text="Thanks to llama.cpp —— 本软件的全部推理能力都建立在开源项目 llama.cpp（GGML 社区，MIT 许可）之上。" />
                    <TextBlock Margin="0,8,0,0" FontSize="12" LineHeight="20" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextDim}"
                               Text="{x:Static app:AppInfo.CreditNotice}" />
                    <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextFaint}"
                               Text="开源仓库：LICENSE（完整许可正文）· THIRD_PARTY_NOTICES.md（第三方组件与 MIT 全文）· runtime/llama/README.md（引擎来源与版本）" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
