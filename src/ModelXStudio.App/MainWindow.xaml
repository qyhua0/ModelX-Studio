<!--
    作者：zhenhua
    功能：主窗口。左侧导航（聊天 / 模型库 / 本地服务 / 设置）+ 右侧四个页面常驻切换，
          切页时刷新模型列表与运行状态；版本与作者信息取自 Helpers/AppInfo。
          标题栏用 WindowChrome + Controls/TitleBar 自绘（Win10 不支持 DWM 给标题栏染色），
          这样顶栏与左侧导航同色，不会再出现“白标题栏 + 深色窗口”的割裂感。
-->
<Window x:Class="ModelXStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:ModelXStudio.App"
        xmlns:views="clr-namespace:ModelXStudio.App.Views"
        xmlns:ctl="clr-namespace:ModelXStudio.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{x:Static app:AppInfo.WindowTitle}"
        Height="780" Width="1220"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BrushBg}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- WindowStyle=None 后系统不再画窗口描边，自己补一条，否则贴在相似颜色的背景上看不出边界 -->
    <Border x:Name="RootBorder" BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctl:TitleBar Grid.Row="0" Caption="{x:Static app:AppInfo.WindowTitle}" />

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="{StaticResource BrushPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,18,20,24">
                    <TextBlock Text="{x:Static app:AppInfo.Name}" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccent}" />
                    <TextBlock Text="{x:Static app:AppInfo.Tagline}" FontSize="11"
                               Foreground="{StaticResource BrushTextDim}" Margin="0,5,0,0" />
                </StackPanel>

                <!-- 版本 / 隐私 / 署名：侧栏只 200 宽，写成一行会断词，所以分两行 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,16">
                    <TextBlock Text="{x:Static app:AppInfo.CreditLine}"
                               FontSize="10" Foreground="{StaticResource BrushTextDim}" />
                    <TextBlock Text="{x:Static app:AppInfo.AuthorLine}" Margin="0,3,0,0"
                               FontSize="10" Foreground="{StaticResource BrushTextFaint}" />
                    <!-- 致谢与许可：完整说明在「设置」页底部与仓库 LICENSE / THIRD_PARTY_NOTICES.md -->
                    <TextBlock Text="{x:Static app:AppInfo.LicenseLine}" Margin="0,3,0,0"
                               FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextFaint}"
                               ToolTip="本软件开源但禁止商用，完整条款见仓库根目录 LICENSE；推理引擎为开源项目 llama.cpp（MIT）" />
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavChat" Style="{StaticResource NavRadio}" IsChecked="True"
                                 Checked="Nav_Checked" Tag="chat">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.3"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M 2 2.5 L 14 2.5 A 1.5 1.5 0 0 1 15.5 4 L 15.5 10.5 A 1.5 1.5 0 0 1 14 12 L 8 12 L 4 15.5 L 4 12 L 2 12 A 0.5 0.5 0 0 1 1.5 11.5 L 1.5 4 A 1.5 1.5 0 0 1 3 2.5 Z" />
                            <TextBlock Text="聊天" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavModels" Style="{StaticResource NavRadio}"
                                 Checked="Nav_Checked" Tag="models">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.3"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M 8 1.5 L 14.5 5 L 14.5 11.5 L 8 15 L 1.5 11.5 L 1.5 5 Z M 1.5 5 L 8 8.5 L 14.5 5 M 8 8.5 L 8 15" />
                            <TextBlock Text="模型库" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavServer" Style="{StaticResource NavRadio}"
                                 Checked="Nav_Checked" Tag="server">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.3"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M 1.5 2.5 L 14.5 2.5 L 14.5 7 L 1.5 7 Z M 1.5 10 L 14.5 10 L 14.5 14.5 L 1.5 14.5 Z M 4 4.7 L 4.01 4.7 M 4 12.2 L 4.01 12.2" />
                            <TextBlock Text="本地服务" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadio}"
                                 Checked="Nav_Checked" Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.3"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M 1 5 L 15 5 M 1 11 L 15 11 M 7.3 5 A 1.8 1.8 0 1 1 3.7 5 A 1.8 1.8 0 1 1 7.3 5 M 11.8 11 A 1.8 1.8 0 1 1 8.2 11 A 1.8 1.8 0 1 1 11.8 11" />
                            <TextBlock Text="设置" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Column="1">
            <views:ChatView x:Name="ViewChat" Visibility="Visible" />
            <views:ModelsView x:Name="ViewModels" Visibility="Collapsed" />
            <views:ServerView x:Name="ViewServer" Visibility="Collapsed" />
            <views:SettingsView x:Name="ViewSettings" Visibility="Collapsed" />
        </Grid>
      </Grid>
      </Grid>
    </Border>
</Window>
