<!--
    作者：zhenhua
    功能：聊天页界面：顶部模型与生成风格选择、引擎状态、消息气泡列表（区分我/ModelX）、
          底部输入框（Enter 发送，Shift+Enter 换行）与「停止生成」。
    许可：ModelX Studio 非商业使用许可 1.0（见仓库根 LICENSE）。上游第三方组件（llama.cpp 等）按各自 MIT 许可授权。
-->
<UserControl x:Class="ModelXStudio.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:ModelXStudio.App">
    <UserControl.Resources>
        <app:BoolToVisibilityConverter x:Key="BoolVis" />
        <app:FalseToVisibilityConverter x:Key="FalseVis" />

        <!-- 消息列表项：无边框无选中高亮 -->
        <Style x:Key="MsgItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 对话列表 -->
        <Border Grid.Column="0" Background="{StaticResource BrushPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,14,12,10" Orientation="Horizontal">
                    <Button Content="＋ 新建对话" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewChatCommand}" Padding="10,6" />
                    <Button Content="删除" Margin="8,0,0,0" Padding="10,6"
                            Command="{Binding DeleteChatCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding SelectedConversation}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="10" Foreground="{StaticResource BrushTextDim}"
                                           Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 聊天区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部：状态 + 模型选择 + 风格 -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding EngineStatusLine}" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextDim}" TextTrimming="CharacterEllipsis" />
                    <ComboBox Grid.Column="1" Width="240" VerticalAlignment="Center"
                              ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModel}"
                              DisplayMemberPath="DisplayName" ToolTip="切换模型（需已下载）" />
                    <ComboBox Grid.Column="2" Width="86" Margin="8,0,0,0" VerticalAlignment="Center"
                              ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding SelectedPreset}"
                              ToolTip="回复风格：快速 / 均衡 / 高质量" />
                </Grid>
            </Border>

            <!-- 消息 -->
            <ListBox Grid.Row="1" x:Name="MessageList"
                     ItemsSource="{Binding Messages}"
                     ItemContainerStyle="{StaticResource MsgItem}"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Padding="16,10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border MaxWidth="760" Padding="12,9" CornerRadius="10" Margin="0,5"
                                Background="{StaticResource BrushBotBubble}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Background" Value="{StaticResource BrushUserBubble}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding RoleLabel}" FontSize="10"
                                           Foreground="{StaticResource BrushTextDim}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                           Foreground="{StaticResource BrushText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 输入区 -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="42" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="InputBox_PreviewKeyDown" />
                    <Button Grid.Column="1" Content="发送" Width="80" Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                            Command="{Binding SendCommand}" />
                    <Button Grid.Column="2" Content="停止" Width="66" Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                            Command="{Binding StopGenerationCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
