<!--
    作者：zhenhua
    功能：深色主题资源字典：配色令牌 + 全部控件样式（文字、按钮、输入框、下拉框、列表、复选框、
          进度条、滚动条、提示气泡、导航、卡片）。改配色和控件观感只动这一个文件；
          配色按「5 级表面 + 单一强调色」组织，避免纯黑纯白刺眼，下拉框与浮层单独用更亮的表面分层。
          两个约定：① 状态用小灯（Led*Core 灯芯 + Led*Halo 柔光晕）而不是 emoji 圆点，WPF 画不出彩色字体；
          ② 下拉框没有数据时，下拉面板里显示 ComboBox.Tag 当提示语（Tag 为空用默认「暂无可选项」），
          且面板宽度至少与下拉框同宽，不再是一个又窄又空的黑框。
    许可：ModelX Studio 非商业使用许可 1.0（见仓库根 LICENSE）。上游第三方组件（llama.cpp 等）按各自 MIT 许可授权。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
    ==================================================================
      ModelX Studio 深色主题
      配色原则：
        · 不用纯黑（#000）和纯白（#FFF）：底色带一点蓝灰，文字用 #E2E5EA，长时间看不刺眼
        · 5 级表面由暗到亮：窗口 → 侧栏/卡片 → 控件底 → 浮层 → 悬停，靠明度分层而不是靠重描边
        · 只有一个强调色（靛蓝），用于「主行动 / 选中 / 焦点」，其它一律中性灰
        · 状态色降饱和（绿/红/黄），只出现在文字与小圆点上，不做大面积底色
    ==================================================================
    -->

    <!--
      页面宽度上限（布局令牌，不放颜色区）：
      以前每个页面各自写死一个数字，最大化后 1920 宽的屏上左右各留 400 px 空白，像没铺满。
      现在的口径：列表类页面基本铺满（只在超宽带鱼屏上封顶），表单和聊天留一个「读得舒服」的上限。
      觉得还是窄或者太宽，只改下面这几个数字，不用去四个 View 里找。
    -->
    <sys:Double x:Key="WidthPageWide">2200</sys:Double>
    <sys:Double x:Key="WidthPageMedium">1600</sys:Double>
    <sys:Double x:Key="WidthPageForm">1520</sys:Double>
    <sys:Double x:Key="WidthChat">1400</sys:Double>
    <sys:Double x:Key="WidthChatBubble">1000</sys:Double>

    <!-- 表面（由暗到亮） -->
    <SolidColorBrush x:Key="BrushBg" Color="#14161A" />
    <SolidColorBrush x:Key="BrushPanel" Color="#191C22" />
    <SolidColorBrush x:Key="BrushPanelAlt" Color="#232830" />
    <SolidColorBrush x:Key="BrushPopup" Color="#262C36" />
    <SolidColorBrush x:Key="BrushHover" Color="#2C333D" />
    <SolidColorBrush x:Key="BrushPressed" Color="#1B1F26" />

    <!-- 描边 -->
    <SolidColorBrush x:Key="BrushBorder" Color="#2C323C" />
    <SolidColorBrush x:Key="BrushBorderSoft" Color="#232830" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#3A424F" />

    <!-- 文字（三档，别再新增第四档） -->
    <SolidColorBrush x:Key="BrushText" Color="#E2E5EA" />
    <SolidColorBrush x:Key="BrushTextDim" Color="#A0A8B4" />
    <SolidColorBrush x:Key="BrushTextFaint" Color="#6E7784" />

    <!-- 强调色：靛蓝 -->
    <SolidColorBrush x:Key="BrushAccent" Color="#6C8EEF" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="#86A5F5" />
    <SolidColorBrush x:Key="BrushAccentPressed" Color="#5470CC" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#242C42" />
    <SolidColorBrush x:Key="BrushSelected" Color="#2A3550" />
    <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF" />
    <!-- 实心控件专用底：上面的 BrushAccent 太亮，白字放上去只有 3.1:1；这三个深色版本≥4.6:1 -->
    <SolidColorBrush x:Key="BrushAccentFill" Color="#4366D0" />
    <SolidColorBrush x:Key="BrushAccentFillHover" Color="#4C6FD9" />
    <SolidColorBrush x:Key="BrushAccentFillPressed" Color="#3A59A8" />
    <SolidColorBrush x:Key="BrushSelection" Color="#3B5488" />

    <!-- 状态色 -->
    <SolidColorBrush x:Key="BrushSuccess" Color="#52B788" />
    <SolidColorBrush x:Key="BrushDanger" Color="#DE6B6E" />
    <SolidColorBrush x:Key="BrushWarning" Color="#D9A05B" />

    <!--
      「指示灯」：模型适配等级用灯表示（等级来自 Core 的 ModelRecommender.Evaluate，
      颜色由 Converters.ModelFitToLedConverter 按等级挑）：绿＝能整份装进显存、蓝＝内存跑没问题、
      黄＝内存紧张、红＝跑不动、灰＝还没检测到硬件。
      灯芯中心偏左上打高光、边缘压暗，在暗底上看着是亮着的；Led*Halo 是同色柔光晕，铺在灯芯底下。
    -->
    <RadialGradientBrush x:Key="LedGreenCore" GradientOrigin="0.34,0.30" Center="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
        <GradientStop Color="#CDF6E2" Offset="0" />
        <GradientStop Color="#63D39C" Offset="0.42" />
        <GradientStop Color="#2E8E63" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LedGreenHalo" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#5952B788" Offset="0" />
        <GradientStop Color="#2A52B788" Offset="0.55" />
        <GradientStop Color="#0052B788" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="LedBlueCore" GradientOrigin="0.34,0.30" Center="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
        <GradientStop Color="#DAE5FF" Offset="0" />
        <GradientStop Color="#7FA6F6" Offset="0.42" />
        <GradientStop Color="#3B60C4" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LedBlueHalo" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#526C8EEF" Offset="0" />
        <GradientStop Color="#266C8EEF" Offset="0.55" />
        <GradientStop Color="#006C8EEF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="LedAmberCore" GradientOrigin="0.34,0.30" Center="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
        <GradientStop Color="#FBEBD2" Offset="0" />
        <GradientStop Color="#E4B273" Offset="0.42" />
        <GradientStop Color="#A0702F" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LedAmberHalo" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#52D9A05B" Offset="0" />
        <GradientStop Color="#26D9A05B" Offset="0.55" />
        <GradientStop Color="#00D9A05B" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="LedRedCore" GradientOrigin="0.34,0.30" Center="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
        <GradientStop Color="#FBDADC" Offset="0" />
        <GradientStop Color="#E8868A" Offset="0.42" />
        <GradientStop Color="#A94A4E" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LedRedHalo" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#52DE6B6E" Offset="0" />
        <GradientStop Color="#26DE6B6E" Offset="0.55" />
        <GradientStop Color="#00DE6B6E" Offset="1" />
    </RadialGradientBrush>

    <!-- 灰灯＝还不知道（没检测到硬件）：故意不给光晕，别让人误读成「亮着」 -->
    <RadialGradientBrush x:Key="LedGreyCore" GradientOrigin="0.34,0.30" Center="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
        <GradientStop Color="#A6AEB9" Offset="0" />
        <GradientStop Color="#79828F" Offset="0.45" />
        <GradientStop Color="#4A515C" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LedGreyHalo" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#14FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>

    <!-- 聊天气泡 -->
    <SolidColorBrush x:Key="BrushUserBubble" Color="#2A3550" />
    <SolidColorBrush x:Key="BrushBotBubble" Color="#232830" />

    <!-- 其它零件 -->
    <SolidColorBrush x:Key="BrushGlyph" Color="#98A1AE" />
    <!-- 提示气泡底色：比卡片略亮一档，仍能托住亮字 -->
    <SolidColorBrush x:Key="BrushTooltip" Color="#22272F" />
    <!-- 标题栏文字：比正文暗一档，不跟内容抢注意力（只给 Helpers/WindowTheme 用） -->
    <SolidColorBrush x:Key="BrushCaptionText" Color="#B6BDC8" />
    <SolidColorBrush x:Key="BrushCaptionHover" Color="#333A45" />
    <SolidColorBrush x:Key="BrushCaptionClose" Color="#B4403A" />

    <FontFamily x:Key="FontUi">Microsoft YaHei UI, Segoe UI</FontFamily>
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>

    <DropShadowEffect x:Key="ShadowPopup" BlurRadius="18" ShadowDepth="4"
                      Direction="270" Opacity="0.55" Color="#000000" />
    <DropShadowEffect x:Key="ShadowCard" BlurRadius="14" ShadowDepth="1"
                      Direction="270" Opacity="0.35" Color="#000000" />

    <!-- ================= 窗口 / 基础文字 ================= -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ================= 按钮 ================= -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="Background" Value="{StaticResource BrushPanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="13,7" />
        <Setter Property="MinHeight" Value="31" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanel}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBorderSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主行动按钮：一屏最多出现一个 -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource BrushAccentFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentFill}" />
        <Setter Property="Foreground" Value="{StaticResource BrushOnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentFillHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccentFillHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentFillPressed}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccentFillPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险操作 -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
        <Setter Property="Background" Value="{StaticResource BrushPanel}" />
        <Setter Property="BorderBrush" Value="#4A3038" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#43303A" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushDanger}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#37272E" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 弱化的文字按钮（次要动作，不带边框） -->
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 自绘标题栏上的三个方按钮（最小化 / 最大化 / 关闭）。 -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource BrushCaptionText}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushCaptionHover}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮：悬停时变红，跟 Windows 习惯一致 -->
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushCaptionClose}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#8F312D" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 文本框 ================= -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushText}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrushSelection}" />
        <Setter Property="Background" Value="{StaticResource BrushPanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="MinHeight" Value="31" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="Bd" Property="Background" Value="#1E232B" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanel}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉框里的可编辑输入框：无框无底，只留光标与文字 -->
    <Style x:Key="ComboBoxEditableTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushText}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrushSelection}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                  Background="Transparent" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 下拉框 ================= -->
    <!-- 展开框本体（ToggleButton）：整块可点，右侧留箭头位 -->
    <ControlTemplate x:Key="ComboBoxToggle" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{StaticResource BrushPanelAlt}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                CornerRadius="7" SnapsToDevicePixels="True">
            <Path x:Name="Arrow" Data="M 0 0 L 4.5 4.5 L 9 0"
                  Stroke="{StaticResource BrushGlyph}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-2,12,0"
                  RenderTransformOrigin="0.5,0.5" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource BrushText}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource BrushAccent}" />
                <Setter TargetName="Arrow" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="180" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushPanel}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBorderSoft}" />
                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource BrushTextFaint}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="31" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MaxDropDownHeight" Value="336" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="ComboRoot">
                        <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboBoxToggle}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                        <!-- 选中项：非编辑模式用这个显示 -->
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="10,4,30,4"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />

                        <!-- 可编辑模式（如设置里的镜像地址）必须有这个部件，否则输入不了 -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Style="{StaticResource ComboBoxEditableTextBox}"
                                 Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Margin="10,0,30,0" VerticalAlignment="Center"
                                 HorizontalContentAlignment="Left" />

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               Placement="Bottom" VerticalOffset="4" HorizontalOffset="0"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <!-- MinWidth 绑下拉框本体宽度（默认模板也是这么做的，ElementName 在模板内的
                                 Popup 里能解析），这样下拉面板至少和下拉框一样宽；条目更长时仍然自己变宽 -->
                            <Border x:Name="DropDownBorder"
                                    Background="{StaticResource BrushPopup}"
                                    BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                                    CornerRadius="8" Padding="0,4"
                                    MinWidth="{Binding ActualWidth, ElementName=ComboRoot}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    SnapsToDevicePixels="True" Effect="{StaticResource ShadowPopup}">
                                <Grid>
                                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>

                                    <!-- 没有可选项时给一句话，而不是一个又窄又空的黑框（看着像程序挂了）。
                                         提示语写在下拉框的 Tag 上；没写就用 TargetNullValue 那句默认值 -->
                                    <TextBlock x:Name="EmptyHint" Visibility="Collapsed"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue='暂无可选项', FallbackValue='暂无可选项'}"
                                               Foreground="{StaticResource BrushTextFaint}" FontSize="12"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="16,12" />
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDownBorder" Property="MinHeight" Value="46" />
                            <Setter TargetName="EmptyHint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉项：这是「下拉里看不清」的正解 —— 深底 + 亮字 + 悬停/选中分明 -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Margin="4,1" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <!-- 选中竖标放在文字左边的空隙里，不能再压着第一个字 -->
                            <Rectangle x:Name="Mark" Width="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource BrushAccentHover}"
                                       HorizontalAlignment="Left" Margin="-9,5,0,5"
                                       Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSelected}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 提示气泡（原来用系统浅色，在深色界面上很扎眼） ================= -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource BrushTooltip}" BorderBrush="{StaticResource BrushBorderStrong}"
                            BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 复选框 ================= -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="5"
                                Background="{StaticResource BrushPanelAlt}"
                                BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="Check" Data="M 0 4 L 3.2 7.2 L 8 0.6"
                                  Stroke="{StaticResource BrushOnAccent}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter x:Name="Txt" Margin="8,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource BrushAccentFill}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushAccentFill}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource BrushPanel}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 进度条 ================= -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        <Setter Property="Background" Value="{StaticResource BrushPanelAlt}" />
        <Setter Property="Height" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" ClipToBounds="True" SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="3" HorizontalAlignment="Left" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Background"
                                    Value="{StaticResource BrushAccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 列表 ================= -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7"
                            Margin="6,1" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Rectangle x:Name="Mark" Width="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource BrushAccentHover}"
                                       HorizontalAlignment="Left" Margin="-11,5,0,5"
                                       Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSelected}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 卡片容器 ================= -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- 指示灯容器：里面叠两颗椭圆（外圈柔光晕 + 灯芯），尺寸默认 12x12，用地方可以就地改 Width/Height。
         适配等级还是 Unknown（没读到硬件信息）时整颗灯不显示，免得摆个灰点让人猜是什么意思。
         绑定属性名写死了 FitLevel：目前只有模型库的两个卡片 ViewModel 有这个名字。 -->
    <Style x:Key="StatusLed" TargetType="Grid">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding FitLevel}" Value="Unknown">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 提示条（下载中 / 出错 / 成功），比卡片更轻 -->
    <Style x:Key="Callout" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="#33405F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- ================= 左侧导航 ================= -->
    <Style x:Key="NavRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            Margin="10,3" Padding="13,10">
                        <Grid>
                            <Rectangle x:Name="Mark" Width="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource BrushAccentHover}"
                                       HorizontalAlignment="Left" Margin="-9,6,0,6"
                                       Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushHover}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSelected}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 滚动条（横向/纵向各一套模板，原模板把横向方向写反了） ================= -->
    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Tb" Background="{StaticResource BrushBorderStrong}"
                            CornerRadius="3.5" Margin="3" MinHeight="24" MinWidth="10" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tb" Property="Background" Value="#4E5766" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Tb" Property="Background" Value="#5A6473" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Tb" Property="Background" Value="{StaticResource BrushBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarPage" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ScrollBarVertical" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ScrollBarHorizontal" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="11" />
        <Setter Property="MinWidth" Value="11" />
        <Setter Property="Template" Value="{StaticResource ScrollBarVertical}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="11" />
                <Setter Property="MinHeight" Value="11" />
                <Setter Property="Template" Value="{StaticResource ScrollBarHorizontal}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
